#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
resolved="$(bash "$repo_root/.devcontainer/ensure-gh.sh" --print-path)"
if [[ ! -x "$resolved" ]]; then
  echo "GitHub CLI bootstrap returned an invalid binary: $resolved" >&2
  exit 1
fi

exec "$resolved" "$@"
