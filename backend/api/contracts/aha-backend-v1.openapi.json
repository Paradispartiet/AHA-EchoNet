{
  "openapi": "3.1.0",
  "info": {
    "title": "AHA Backend API",
    "version": "0.2.0",
    "description": "Fail-closed backend contract. Express remains primary. Canonical reads, local account import and personal/private canonical sync are separate opt-in boundaries. Login never implies import or sync."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Public liveness and foundation boundary status",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/v1/auth/context": {
      "get": {
        "operationId": "getAuthContext",
        "summary": "Return the verified immutable authentication context",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Verified principal context",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthContextResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "operationId": "getCurrentProfile",
        "summary": "Return the current canonical profile through an RLS-bound read session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Bounded current profile read model",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/local-imports/confirmation": {
      "post": {
        "operationId": "createLocalImportConfirmation",
        "summary": "Create a short-lived confirmation challenge from local preview hashes and counts",
        "description": "The preview itself is built on-device. This endpoint must never receive the raw local dataset or canonical import plan.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalImportConfirmationRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Short-lived confirmation challenge; no import data was uploaded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalImportConfirmationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "413": { "$ref": "#/components/responses/ImportTooLarge" },
          "503": { "$ref": "#/components/responses/ImportUnavailable" }
        }
      }
    },
    "/v1/local-imports/commit": {
      "post": {
        "operationId": "commitLocalImport",
        "summary": "Explicitly commit the exact hash-bound local import plan",
        "description": "This is the first request allowed to contain the canonicalized plan. The server recalculates planHash, verifies the principal-bound confirmation and commits through one idempotent canonical database command.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalImportCommitRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Import committed or replayed idempotently",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalImportCommitResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "409": { "$ref": "#/components/responses/ImportConflict" },
          "413": { "$ref": "#/components/responses/ImportTooLarge" },
          "503": { "$ref": "#/components/responses/ImportUnavailable" }
        }
      }
    },
    "/v1/sync/bootstrap": {
      "get": {
        "operationId": "bootstrapCanonicalSync",
        "summary": "Read an initial personal/private canonical sync snapshot",
        "description": "Opt-in read boundary for a first device or pre-journal account state. The first page returns a highWatermark that must be reused for later bootstrap pages before delta pull begins. This route never writes and never activates sync by login.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } },
          { "name": "afterKey", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 1024, "default": "" } },
          { "name": "highWatermark", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 500 } }
        ],
        "responses": {
          "200": {
            "description": "Canonical snapshot page. Deleted objects have payload=null.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncBootstrapResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "503": { "$ref": "#/components/responses/SyncUnavailable" }
        }
      }
    },
    "/v1/sync/pull": {
      "get": {
        "operationId": "pullCanonicalSyncChanges",
        "summary": "Read monotone canonical sync changes after a cursor",
        "description": "Opt-in delta read. Multiple journal rows for the same object collapse to its latest state in the requested window. Tombstones never return raw object payload.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } },
          { "name": "afterCursor", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 500 } }
        ],
        "responses": {
          "200": {
            "description": "Canonical delta page",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncPullResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "503": { "$ref": "#/components/responses/SyncUnavailable" }
        }
      }
    },
    "/v1/sync/push": {
      "post": {
        "operationId": "pushCanonicalSyncChange",
        "summary": "Explicitly push one hash-bound canonical personal/private change",
        "description": "The NestJS boundary recomputes SHA-256 over deterministic canonical JSON before the database command runs. For delete, payload is null and payloadHash is the SHA-256 of canonical JSON null. Expected stale-base/tombstone conflicts are returned as a 200 success envelope whose data.status is conflict; they are never resolved automatically.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncPushRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Change applied/replayed, safe no-op, or explicit conflict business result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncPushResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "413": { "$ref": "#/components/responses/SyncPayloadTooLarge" },
          "503": { "$ref": "#/components/responses/SyncUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A signed JWT verified against the configured issuer, audience and JWKS."
      }
    },
    "schemas": {
      "ApiMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "apiVersion"],
        "properties": {
          "requestId": { "type": "string" },
          "apiVersion": { "type": "string" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "status", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "integer" },
              "requestId": { "type": "string" }
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiVersion", "timestamp"],
            "properties": {
              "apiVersion": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "version", "runtimeActivated", "existingExpressRuntimePrimary", "database", "auth"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "aha-nest-api" },
          "version": { "type": "string" },
          "runtimeActivated": { "const": false },
          "existingExpressRuntimePrimary": { "const": true },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "connected", "status", "safeRuntimeRole", "canonicalSchema"],
            "properties": {
              "configured": { "type": "boolean" },
              "connected": { "type": "boolean" },
              "status": { "type": "string", "enum": ["disabled", "unknown", "ready", "unsafe_role", "schema_missing", "unavailable"] },
              "safeRuntimeRole": { "type": "boolean" },
              "canonicalSchema": { "type": "string", "enum": ["present", "not_connected"] }
            }
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured"],
            "properties": { "configured": { "type": "boolean" } }
          }
        }
      },
      "AuthContextData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authenticated", "principal"],
        "properties": {
          "authenticated": { "const": true },
          "principal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "provider", "issuer", "audience"],
            "properties": {
              "subject": { "type": "string" },
              "provider": { "type": "string" },
              "issuer": { "type": "string", "format": "uri" },
              "audience": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      },
      "AuthContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthContextData" },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "ProfileData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "locale", "timezone", "status", "createdAt", "updatedAt", "revision"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": ["string", "null"] },
          "locale": { "type": "string" },
          "timezone": { "type": "string" },
          "status": { "const": "active" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/ProfileData" },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "LocalImportCounts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversations", "messages", "sourceEvents", "insights", "conceptLists", "conceptListItems", "knowledgePaths", "knowledgePathSteps", "articles", "articleReferences", "total"],
        "properties": {
          "conversations": { "type": "integer", "minimum": 0 },
          "messages": { "type": "integer", "minimum": 0 },
          "sourceEvents": { "type": "integer", "minimum": 0 },
          "insights": { "type": "integer", "minimum": 0 },
          "conceptLists": { "type": "integer", "minimum": 0 },
          "conceptListItems": { "type": "integer", "minimum": 0 },
          "knowledgePaths": { "type": "integer", "minimum": 0 },
          "knowledgePathSteps": { "type": "integer", "minimum": 0 },
          "articles": { "type": "integer", "minimum": 0 },
          "articleReferences": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "LocalImportConfirmationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKind", "sourceVersion", "payloadHash", "planHash", "counts"],
        "properties": {
          "sourceKind": { "const": "aha_local_backup" },
          "sourceVersion": { "const": "v1" },
          "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "counts": { "$ref": "#/components/schemas/LocalImportCounts" }
        }
      },
      "LocalImportConfirmationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["confirmationToken", "expiresAt", "policyVersion", "binds", "dataUploaded", "nextAction"],
            "properties": {
              "confirmationToken": { "type": "string" },
              "expiresAt": { "type": "string", "format": "date-time" },
              "policyVersion": { "const": "aha_account_import_v1" },
              "binds": { "$ref": "#/components/schemas/LocalImportConfirmationRequest" },
              "dataUploaded": { "const": false },
              "nextAction": { "const": "show_exact_local_preview_then_require_user_confirmation" }
            }
          },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "LocalImportPlan": {
        "type": "object",
        "description": "Canonicalized allow-listed plan generated locally. Unknown root keys are rejected by the service.",
        "required": ["version", "sourceKind", "sourceVersion", "conversations", "messages", "sourceEvents", "insights", "conceptLists", "conceptListItems", "knowledgePaths", "knowledgePathSteps", "articles", "articleReferences"],
        "properties": {
          "version": { "const": "aha_local_import_plan_v1" },
          "sourceKind": { "const": "aha_local_backup" },
          "sourceVersion": { "const": "v1" },
          "conversations": { "type": "array", "items": { "type": "object" } },
          "messages": { "type": "array", "items": { "type": "object" } },
          "sourceEvents": { "type": "array", "items": { "type": "object" } },
          "insights": { "type": "array", "items": { "type": "object" } },
          "conceptLists": { "type": "array", "items": { "type": "object" } },
          "conceptListItems": { "type": "array", "items": { "type": "object" } },
          "knowledgePaths": { "type": "array", "items": { "type": "object" } },
          "knowledgePathSteps": { "type": "array", "items": { "type": "object" } },
          "articles": { "type": "array", "items": { "type": "object" } },
          "articleReferences": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      },
      "LocalImportCommitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKind", "sourceVersion", "payloadHash", "planHash", "idempotencyKey", "confirmationToken", "plan"],
        "properties": {
          "sourceKind": { "const": "aha_local_backup" },
          "sourceVersion": { "const": "v1" },
          "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 160 },
          "confirmationToken": { "type": "string", "minLength": 32 },
          "plan": { "$ref": "#/components/schemas/LocalImportPlan" }
        }
      },
      "LocalImportCommitResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "description": "Contains import batch/workspace/consent receipt identifiers, result counts, hashes and replay status."
          },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "CanonicalSyncObjectType": {
        "type": "string",
        "enum": ["conversation", "message", "source_event", "insight", "concept_list", "concept_list_item", "knowledge_path", "knowledge_path_step", "article", "article_reference"]
      },
      "CanonicalSyncPayload": {
        "type": "object",
        "description": "Canonical snake_case personal/private object payload. Server-owned workspace/profile identity fields are forbidden. The database command performs object-type-specific validation and never accepts local-only object types.",
        "additionalProperties": true
      },
      "SyncPushRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspaceId", "deviceId", "idempotencyKey", "objectType", "objectId", "operation", "baseRevision", "payloadHash"],
        "properties": {
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "deviceId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 256 },
          "objectType": { "$ref": "#/components/schemas/CanonicalSyncObjectType" },
          "objectId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "operation": { "type": "string", "enum": ["upsert", "delete"] },
          "baseRevision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "payloadHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of deterministic canonical JSON. For delete this is SHA-256 of JSON null." },
          "payload": {
            "oneOf": [
              { "$ref": "#/components/schemas/CanonicalSyncPayload" },
              { "type": "null" }
            ],
            "description": "Required object for upsert; null or omitted for delete."
          }
        }
      },
      "SyncObjectEnvelope": {
        "type": "object",
        "additionalProperties": true,
        "description": "Canonical sync object/change descriptor. Tombstones have payload=null and never expose raw deleted content."
      },
      "SyncBootstrapResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": ["workspaceId", "highWatermark", "nextKey", "returnedCount", "hasMore", "objects"],
            "properties": {
              "workspaceId": { "type": "string" },
              "highWatermark": { "type": "integer", "minimum": 0 },
              "nextKey": { "type": "string" },
              "returnedCount": { "type": "integer", "minimum": 0 },
              "hasMore": { "type": "boolean" },
              "objects": { "type": "array", "items": { "$ref": "#/components/schemas/SyncObjectEnvelope" } }
            }
          },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "SyncPullResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": ["workspaceId", "highWatermark", "nextCursor", "returnedCount", "hasMore", "changes"],
            "properties": {
              "workspaceId": { "type": "string" },
              "highWatermark": { "type": "integer", "minimum": 0 },
              "nextCursor": { "type": "integer", "minimum": 0 },
              "returnedCount": { "type": "integer", "minimum": 0 },
              "hasMore": { "type": "boolean" },
              "changes": { "type": "array", "items": { "$ref": "#/components/schemas/SyncObjectEnvelope" } }
            }
          },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "SyncPushResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "status is synced or conflict. Conflict data includes reason/baseRevision/serverRevision and serverState when safe. No automatic resolution occurs."
          },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "A valid bearer token is required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "NotFound": {
        "description": "The requested canonical object was not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "ValidationFailed": {
        "description": "Request validation, sync hash validation or canonical payload validation failed",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "ImportConflict": {
        "description": "The import confirmation expired, the plan changed, or the idempotency key conflicts",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "ImportTooLarge": {
        "description": "The configured local import object limit was exceeded",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "SyncPayloadTooLarge": {
        "description": "The canonical sync payload exceeds the configured API size limit",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "DatabaseUnavailable": {
        "description": "The canonical database is disabled, unavailable, unsafe or not ready",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "ImportUnavailable": {
        "description": "Local import or its canonical database command is not enabled/available",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      },
      "SyncUnavailable": {
        "description": "Canonical sync is disabled or the canonical database is unavailable/unsafe/not ready",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } }
      }
    }
  }
}
