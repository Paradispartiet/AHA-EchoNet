{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradispartiet.github.io/AHA-EchoNet/schemas/aha-projection-product-read-model-v2.schema.json",
  "title": "AHA Projection Product Read Model V2",
  "type": "object",
  "required": ["schema", "version", "mode", "status", "surfaces", "validation", "policy"],
  "properties": {
    "schema": { "const": "aha_projection_product_read_model_v2" },
    "version": { "const": 2 },
    "mode": { "const": "read_only" },
    "status": { "enum": ["ready", "blocked"] },
    "gate_id": { "type": ["string", "null"] },
    "projection_id": { "type": ["string", "null"] },
    "source_mode": { "type": "string" },
    "analysis_bundle_id": { "type": ["string", "null"] },
    "identity": {
      "type": ["object", "null"],
      "properties": {
        "analysis_id": { "type": "string" },
        "analysis_run_id": { "type": "string" },
        "source_id": { "type": "string" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "product_states": {
      "type": "object",
      "properties": {
        "list": { "$ref": "#/$defs/productState" },
        "path": { "$ref": "#/$defs/productState" },
        "mindmap": { "$ref": "#/$defs/productState" }
      },
      "required": ["list", "path", "mindmap"]
    },
    "surfaces": {
      "type": "object",
      "required": ["insights", "concepts", "lists", "paths", "mindmap"],
      "properties": {
        "insights": { "type": "array" },
        "concepts": { "type": "array" },
        "lists": { "type": "array" },
        "paths": { "type": "array" },
        "mindmap": {
          "type": "object",
          "required": ["nodes", "edges", "read_only"],
          "properties": {
            "nodes": { "type": "array" },
            "edges": { "type": "array" },
            "read_only": { "const": true }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": { "type": "object" }
  },
  "$defs": {
    "productState": {
      "type": "object",
      "required": ["status", "label", "reason", "candidate_count", "href"],
      "properties": {
        "status": { "enum": ["ready", "needs_evidence", "not_relevant"] },
        "label": { "enum": ["Klar til forhåndsvisning", "Trenger mer belegg", "Ikke relevant for denne teksten"] },
        "reason": { "type": "string", "minLength": 1 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "href": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
