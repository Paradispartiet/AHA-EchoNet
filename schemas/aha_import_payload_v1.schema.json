{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paradispartiet.github.io/AHA-EchoNet/schemas/aha_import_payload_v1.schema.json",
  "title": "History Go to AHA import payload v1",
  "description": "Canonical private import boundary from History Go into AHA-EchoNet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "source",
    "exported_at",
    "hg_knowledge_entries_v2",
    "hg_learning_log_v1",
    "hg_insights_events_v1",
    "notes",
    "dialogs",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "aha_import_payload_v1" },
    "contract_version": { "const": 1 },
    "user_id": { "type": ["string", "null"] },
    "profile_id": { "type": ["string", "null"] },
    "source": { "const": "historygo" },
    "auth_source": { "type": "string" },
    "exported_at": { "type": "string", "format": "date-time" },
    "synced_from_historygo_at": { "type": "string", "format": "date-time" },
    "aha_display_name": { "type": "string" },
    "hg_knowledge_entries_v2": { "type": "array", "items": { "type": "object" } },
    "hg_knowledge_memory_v1": { "type": "object" },
    "knowledge_universe": { "type": "object", "deprecated": true },
    "hg_learning_log_v1": { "type": "array", "items": { "type": "object" } },
    "hg_insights_events_v1": { "type": "array", "items": { "type": "object" } },
    "merits_by_category": { "type": "object" },
    "visited_places": { "type": "object" },
    "people_collected": { "type": ["object", "array"] },
    "hg_unlocks_v1": { "type": ["object", "array"] },
    "quiz_progress": { "type": "object" },
    "historygo_progress": { "type": "object" },
    "trivia_universe": { "type": "object" },
    "hg_groundhopper_stats_v1": { "type": "object" },
    "hg_pc_wallet_v1": { "type": "object" },
    "local_profile": { "type": "object" },
    "aha_profile_cache": { "type": "object" },
    "nextup": { "type": "object" },
    "nextup_learning_signal": { "type": "object" },
    "hg_nextup_tri": { "type": "object" },
    "hg_nextup_history_v1": { "type": "array", "items": { "type": "object" } },
    "hg_nextup_because": { "type": "string" },
    "hg_nextup_mode_v1": { "type": "object" },
    "hg_active_path_v1": { "type": "object" },
    "nextup_profile": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "object" } },
    "dialogs": { "type": "array", "items": { "type": "object" } },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "public_sharing", "model_training_allowed"],
      "properties": {
        "scope": { "const": "private_user" },
        "public_sharing": { "const": false },
        "model_training_allowed": { "const": false }
      }
    }
  }
}
