{
  "openapi": "3.1.0",
  "info": {
    "title": "AHA Backend API",
    "version": "0.2.0",
    "description": "Read-only foundation contract. The existing Express service remains primary and no canonical write API is active."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Public liveness and foundation boundary status",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is alive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/context": {
      "get": {
        "operationId": "getAuthContext",
        "summary": "Return the verified immutable authentication context",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Verified principal context",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthContextResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" }
        }
      }
    },
    "/v1/profile": {
      "get": {
        "operationId": "getCurrentProfile",
        "summary": "Return the current canonical profile through an RLS-bound read session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Bounded current profile read model",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfileResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/AuthRequired" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A signed JWT verified against the configured issuer, audience and JWKS."
      }
    },
    "schemas": {
      "ApiMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "apiVersion"],
        "properties": {
          "requestId": { "type": "string" },
          "apiVersion": { "type": "string" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "status", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "integer" },
              "requestId": { "type": "string" }
            }
          },
          "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiVersion", "timestamp"],
            "properties": {
              "apiVersion": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "version", "runtimeActivated", "existingExpressRuntimePrimary", "database", "auth"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "aha-nest-api" },
          "version": { "type": "string" },
          "runtimeActivated": { "const": false },
          "existingExpressRuntimePrimary": { "const": true },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured", "connected", "status", "safeRuntimeRole", "canonicalSchema"],
            "properties": {
              "configured": { "type": "boolean" },
              "connected": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["disabled", "unknown", "ready", "unsafe_role", "schema_missing", "unavailable"]
              },
              "safeRuntimeRole": { "type": "boolean" },
              "canonicalSchema": { "type": "string", "enum": ["present", "not_connected"] }
            }
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configured"],
            "properties": {
              "configured": { "type": "boolean" }
            }
          }
        }
      },
      "AuthContextData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authenticated", "principal"],
        "properties": {
          "authenticated": { "const": true },
          "principal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "provider", "issuer", "audience"],
            "properties": {
              "subject": { "type": "string" },
              "provider": { "type": "string" },
              "issuer": { "type": "string", "format": "uri" },
              "audience": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "AuthContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/AuthContextData" },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      },
      "ProfileData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "locale", "timezone", "status", "createdAt", "updatedAt", "revision"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": ["string", "null"] },
          "locale": { "type": "string" },
          "timezone": { "type": "string" },
          "status": { "const": "active" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/ProfileData" },
          "meta": { "$ref": "#/components/schemas/ApiMeta" }
        }
      }
    },
    "responses": {
      "AuthRequired": {
        "description": "A valid bearer token is required",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "NotFound": {
        "description": "The requested canonical object was not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "DatabaseUnavailable": {
        "description": "The canonical database is disabled, unavailable, unsafe or not ready",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      }
    }
  }
}
