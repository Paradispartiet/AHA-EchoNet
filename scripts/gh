#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bash "$repo_root/.devcontainer/ensure-gh.sh" >/dev/null

if command -v gh >/dev/null 2>&1; then
  exec gh "$@"
fi

for candidate in \
  "${AHA_GH_BIN_DIR:-}" \
  "/workspace/bin" \
  "$repo_root/.tools/bin"; do
  [[ -n "$candidate" && -x "$candidate/gh" ]] || continue
  exec "$candidate/gh" "$@"
done

echo "GitHub CLI bootstrap completed without a discoverable binary." >&2
exit 1
