{
  "version": "aha_canonical_sync_production_rollout_v1",
  "status": "blocked_until_remote_readiness",
  "productionActivationEnabled": false,
  "hosting": {
    "target": "azure_container_apps",
    "adr": "docs/adr/ADR-006-azure-container-apps-before-aks.md",
    "renderProductionAllowed": false,
    "euEeaRegionRequired": true,
    "infrastructureAsCodeRequired": true
  },
  "database": {
    "target": "dedicated_production_postgresql",
    "stagingReuseAllowed": false,
    "legacyPrimaryReuseAllowed": false,
    "tlsMode": "verify-full",
    "runtimeRole": "aha_canonical_production_runtime",
    "runtimeRoleMustStartNoLogin": true,
    "adminCredentialInRuntimeAllowed": false
  },
  "frontend": {
    "allowedOrigin": "https://paradispartiet.github.io",
    "automaticSync": false,
    "loginTriggeredSync": false,
    "authReadyTriggeredSync": false,
    "backgroundSync": false,
    "legacySyncHubActivation": false,
    "manualProductionPilotBridgeImplemented": true,
    "manualProductionPilotBridgePage": "canonical-sync-production-pilot.html",
    "manualProductionPilotRequiresExplicitUrlGate": true,
    "manualProductionPilotRequiresExplicitConsent": true,
    "manualProductionPilotRequiresExplicitApiOrigin": true,
    "manualProductionPilotWorkspaceDerivedFromAuthenticatedSubject": true,
    "manualProductionPilotUserSelectableWorkspace": false,
    "manualProductionPilotPrimarySourceHydration": false,
    "manualProductionPilotAppliesServerStateToRealLocalCanonicalStorage": true,
    "manualProductionPilotRendersRawPayload": false,
    "manualProductionPilotRendersProfileOrWorkspaceIdentifier": false
  },
  "pilot": {
    "mode": "bounded_manual_allowlist",
    "maxProfiles": 10,
    "profilesAddedPerActivation": 1,
    "profileIdentifierMustComeFromProtectedEnvironment": true,
    "publicProfileIdentifierAllowed": false,
    "serverSideAllowlistRequired": true,
    "automaticExpansionAllowed": false,
    "groupOrPublicSharingAllowed": false
  },
  "canonicalObjectTypes": [
    "conversation",
    "message",
    "source_event",
    "insight",
    "concept_list",
    "concept_list_item",
    "knowledge_path",
    "knowledge_path_step",
    "article",
    "article_reference"
  ],
  "migration": {
    "required": true,
    "stagingRehearsalRequired": true,
    "productionSchemaReadinessRequired": true,
    "backupBeforeMigrationRequired": true,
    "restoreTestRequired": true,
    "destructiveMigrationInPilotAllowed": false,
    "productionDataCopiedToStagingAllowed": false,
    "rollback": {
      "previousApiRevisionRequired": true,
      "databaseCredentialCutoffRequired": true,
      "activeSessionTerminationRequired": true,
      "schemaStrategy": "forward_fix_or_verified_restore",
      "automaticDestructiveDownMigrationAllowed": false
    }
  },
  "observability": {
    "required": true,
    "rawConversationTextInDefaultTelemetryAllowed": false,
    "tokensOrSecretsInTelemetryAllowed": false,
    "requiredSignals": [
      "request_rate",
      "request_latency",
      "http_errors",
      "database_connections",
      "database_query_load",
      "auth_rejections",
      "permission_rejections",
      "sync_conflicts",
      "sync_push_results",
      "deployment_revision",
      "migration_revision",
      "data_export_events",
      "data_deletion_events"
    ]
  },
  "stagingEvidence": {
    "path": "ops/evidence/canonical-sync-browser-staging-proof-v1.json",
    "required": true,
    "idempotenceRequired": true,
    "zeroConflictRequired": true,
    "excludedLocalDeferredSourcesRequired": true
  },
  "remoteReadiness": {
    "githubEnvironment": "aha-canonical-production-readiness",
    "exactConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_ROLLOUT_GATE",
    "requiredProtectedValues": [
      "AHA_PRODUCTION_API_ORIGIN",
      "AHA_PRODUCTION_PILOT_PROFILE_ID",
      "AHA_PRODUCTION_ROLLBACK_REVISION",
      "AHA_PRODUCTION_MIGRATION_REHEARSAL_EVIDENCE",
      "AHA_PRODUCTION_BACKUP_RESTORE_EVIDENCE",
      "AHA_PRODUCTION_OBSERVABILITY_EVIDENCE",
      "AHA_PRODUCTION_SYNC_RUNTIME_STATE"
    ]
  },
  "privateDatabaseReadiness": {
    "githubEnvironment": "aha-canonical-production-infra",
    "executionBoundary": "production_vnet",
    "verificationMode": "verify_restore",
    "liveSyncMustRemainDisabled": true,
    "adminCredentialSource": "operations_key_vault",
    "publicRunnerDirectDatabaseAccessAllowed": false
  },
  "activation": {
    "separateWorkflowRequired": true,
    "workflowImplemented": true,
    "githubEnvironment": "aha-canonical-production-infra",
    "rolloutGateMustPassFirst": true,
    "sameShaRolloutGateRequired": true,
    "protectedPilotProfileRequired": true,
    "serverSidePilotAllowlistRequired": true,
    "databaseFirstActivationRequired": true,
    "runtimeCredentialRotationRequired": true,
    "runtimeRoleLoginOnlyDuringActivePilot": true,
    "localImportEnabled": false,
    "automaticSyncEnabled": false,
    "loginTriggeredSyncEnabled": false,
    "backgroundSyncEnabled": false,
    "databaseFirstRollbackRequired": true,
    "activeSessionTerminationOnRollbackRequired": true,
    "destructivePilotDataRollbackAllowed": false,
    "emergencyRollbackWorkflowImplemented": true,
    "manualPilotSyncRequiresSeparateExplicitUserAction": true,
    "manualPilotSyncConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_PILOT_SYNC",
    "enabled": false,
    "exactPilotConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_PILOT_ACTIVATION",
    "exactPilotRollbackConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_PILOT_ROLLBACK",
    "expansion": {
      "workflowImplemented": true,
      "sameShaExpansionGateRequired": true,
      "candidateBoundGateEvidenceRequired": true,
      "protectedCandidateProfileRequired": true,
      "oneProfilePerActivationRequired": true,
      "versionPinnedAllowlistSecretRequired": true,
      "runtimeCredentialRotationAllowed": false,
      "sharedRuntimeRoleMutationAllowed": false,
      "automaticExecutionAllowed": false,
      "perProfileRollbackWorkflowImplemented": true,
      "perProfileRollbackRemovesApiAllowlistFirst": true,
      "perProfileRollbackMayRemoveLegacyAnchor": false,
      "destructiveExpandedProfileRollbackAllowed": false,
      "canonicalDataRetainedOnRollback": true,
      "exactExpansionConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_PILOT_EXPANSION_ACTIVATION",
      "exactPerProfileRollbackConfirmation": "RUN_AHA_CANONICAL_PRODUCTION_PILOT_PROFILE_ROLLBACK"
    }
  }
}
